{
  "expo": {
    "name": "Orbe",
    "slug": "orbe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "orbe",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.jvdslabs.orbe",
      "versionCode": 3,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0e14"
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/withOptionalPortrait"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
